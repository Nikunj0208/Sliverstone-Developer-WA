{
  "name": "silverstone-whatsapp-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Silverstone real-estate WhatsApp Cloud API demo",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && mkdir -p dist/src/db && cp -f src/db/schema.sql dist/src/db/schema.sql",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "validate:env": "tsx src/config/validate.ts",
    "whatsapp:test": "tsx scripts/send-test-message.ts",
    "broadcast": "tsx scripts/broadcast.ts",
    "meta:check-template": "tsx scripts/check-template.ts",
    "meta:check-waba": "tsx scripts/check-waba-subscription.ts",
    "meta:subscribe-waba": "tsx scripts/subscribe-waba.ts",
    "meta:diagnose": "tsx scripts/meta-production-diagnostic.ts",
    "qr": "tsx scripts/create-qr.ts",
    "sync:logs": "tsx scripts/sync-broadcast-logs-to-crm.ts",
    "meta:import": "tsx scripts/import-meta-activity.ts",
    "batch14:auto": "tsx scripts/automate-batch-14.ts",
    "batch15:auto": "tsx scripts/automate-batch-15.ts",
    "batch16:auto": "tsx scripts/automate-batch-16.ts",
    "batch17:auto": "tsx scripts/automate-batch-17.ts",
    "batch18:auto": "tsx scripts/automate-batch-18.ts",
    "batch19:auto": "tsx scripts/automate-batch-19.ts",
    "batch20:auto": "tsx scripts/automate-batch-20.ts",
    "batch21:auto": "tsx scripts/automate-batch-21.ts",
    "batch22:auto": "tsx scripts/automate-batch-22.ts",
    "batch23:auto": "tsx scripts/automate-batch-23.ts",
    "batch24:auto": "tsx scripts/automate-batch-24.ts",
    "queue1800:auto": "tsx scripts/automate-queue-1800.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop silverstone-crm",
    "pm2:restart": "pm2 restart silverstone-crm",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs silverstone-crm",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "axios": "^1.8.4",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "pm2": "^7.1.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
